{
  "name": "balsamic",
  "productName": "Balsamic",
  "version": "0.1.0",
  "description": "An offline-first desktop wireframing editor for macOS and Windows.",
  "main": ".vite/build/main.js",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "22.22.x",
    "npm": "10.9.x"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:fuses": "node scripts/verify-packaged-fuses.mjs",
    "verify:project-workflow:packaged": "node scripts/run-packaged-project-workflow-probe.mjs",
    "verify:recovery:packaged": "node scripts/run-packaged-recovery-probe.mjs",
    "verify:viewport-performance:packaged": "node scripts/run-packaged-viewport-performance.mjs",
    "smoke:packaged": "node scripts/run-packaged-smoke.mjs",
    "visual:packaged": "node scripts/run-packaged-visual-fixtures.mjs",
    "verify": "npm run format:check && npm run lint && npm run check:boundaries && npm run typecheck && npm run test && npm run audit:runtime"
  },
  "dependencies": {
    "@fontsource/comic-neue": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "electron-squirrel-startup": "1.0.1",
    "fflate": "0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7"
  }
}
